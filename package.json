{
  "name": "nightjar-tizen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nightjar for Samsung Tizen. A Rubylight WebRTC TV client.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
