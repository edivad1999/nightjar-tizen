  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  }
}
